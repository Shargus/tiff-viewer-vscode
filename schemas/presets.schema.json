{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TIFF Viewer VS Code band composite presets",
  "description": "Presets shown in the viewer's Bands menu.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "anyOf": [
              {
                "required": [
                  "red"
                ]
              },
              {
                "required": [
                  "green"
                ]
              },
              {
                "required": [
                  "blue"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "paletted"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the Bands menu."
              },
              "red": {
                "type": "string",
                "description": "Red channel expression over band names, e.g. `B04 / 3000`. Bands are b1…bN, the file's band descriptions (e.g. B04, VV) and the names in `bands`."
              },
              "green": {
                "type": "string",
                "description": "Green channel expression over band names, e.g. `B04 / 3000`. Bands are b1…bN, the file's band descriptions (e.g. B04, VV) and the names in `bands`."
              },
              "blue": {
                "type": "string",
                "description": "Blue channel expression over band names, e.g. `B04 / 3000`. Bands are b1…bN, the file's band descriptions (e.g. B04, VV) and the names in `bands`."
              },
              "value": {
                "type": "string",
                "description": "Single-band (shown with `colormap`); used when red/green/blue are absent expression over band names, e.g. `B04 / 3000`. Bands are b1…bN, the file's band descriptions (e.g. B04, VV) and the names in `bands`."
              },
              "paletted": {
                "type": "string",
                "markdownDescription": "Paletted / unique values (as in QGIS): the band, or an expression, whose values are listed in `classes`. Values not listed are transparent."
              },
              "classes": {
                "type": "array",
                "description": "Classes of a paletted preset (at most 256).",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "color"
                  ],
                  "properties": {
                    "value": {
                      "type": "number",
                      "description": "The value."
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                      "markdownDescription": "`#rrggbb`, or `#rrggbbaa` with opacity."
                    },
                    "label": {
                      "type": "string",
                      "description": "Label, shown in the pixel readout."
                    }
                  }
                },
                "maxItems": 256
              },
              "colorRamp": {
                "type": "string",
                "enum": [
                  "random",
                  "gray",
                  "viridis",
                  "magma",
                  "inferno",
                  "plasma",
                  "turbo",
                  "RdYlGn",
                  "RdBu",
                  "Spectral",
                  "terrain",
                  "gray_r",
                  "viridis_r",
                  "magma_r",
                  "inferno_r",
                  "plasma_r",
                  "turbo_r",
                  "RdYlGn_r",
                  "RdBu_r",
                  "Spectral_r",
                  "terrain_r"
                ],
                "default": "random",
                "description": "Colours given by Classify and + in a paletted preset: \"random\" (QGIS's random colours) or a colour map."
              },
              "range": {
                "markdownDescription": "Values shown as black … full brightness: `[min, max]`, or an automatic stretch: `\"auto\"` (or `\"minmax\"`: the image's min / max), `\"percentile\"` (2% / 98%), `\"full\"` (the data type's range). One for all channels, or one per channel. Default `[0, 1]`.",
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "string",
                    "enum": [
                      "auto",
                      "minmax",
                      "percentile",
                      "full"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        {
                          "type": "string",
                          "enum": [
                            "auto",
                            "minmax",
                            "percentile",
                            "full"
                          ]
                        }
                      ]
                    }
                  }
                ]
              },
              "colormap": {
                "type": "string",
                "enum": [
                  "gray",
                  "viridis",
                  "magma",
                  "inferno",
                  "plasma",
                  "turbo",
                  "RdYlGn",
                  "RdBu",
                  "Spectral",
                  "terrain",
                  "gray_r",
                  "viridis_r",
                  "magma_r",
                  "inferno_r",
                  "plasma_r",
                  "turbo_r",
                  "RdYlGn_r",
                  "RdBu_r",
                  "Spectral_r",
                  "terrain_r"
                ],
                "default": "gray",
                "description": "Colour map for a single-band expression (`_r` reverses it)."
              },
              "brightness": {
                "type": "number",
                "minimum": -255,
                "maximum": 255,
                "default": 0,
                "description": "As in QGIS: -255 to 255, added to every colour component."
              },
              "contrast": {
                "type": "number",
                "minimum": -100,
                "maximum": 100,
                "default": 0,
                "description": "As in QGIS: -100 to 100."
              },
              "saturation": {
                "type": "number",
                "minimum": -100,
                "maximum": 100,
                "default": 0,
                "description": "As in QGIS: -100 (grey) to 100."
              },
              "gamma": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10,
                "default": 1,
                "description": "As in QGIS: 0.1 to 10; above 1 brightens dark tones."
              },
              "bands": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 1
                },
                "markdownDescription": "Extra band names for files without band descriptions: name → 1-based band number, e.g. `{ \"B04\": 4, \"B08\": 8 }`."
              },
              "variables": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "markdownDescription": "Named intermediate expressions, in order. Each may use the bands and the variables defined before it; the channel expressions may use all of them. Each is computed once per pixel, e.g. `{ \"ndvi\": \"(B08 - B04) / (B08 + B04)\" }`."
              },
              "match": {
                "type": "object",
                "markdownDescription": "Apply the preset automatically to files that match all given conditions (the first matching preset wins; a choice made in the viewer overrides it for that file).",
                "properties": {
                  "bands": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      }
                    ],
                    "description": "Number of bands."
                  },
                  "fileName": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "File name pattern(s): * matches any text, ? one character; case-insensitive."
                  }
                }
              }
            }
          },
          "description": "Band rendering presets."
        }
      },
      "required": [
        "presets"
      ]
    },
    {
