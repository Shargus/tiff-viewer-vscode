{
  "name": "tiff-viewer-vscode",
  "displayName": "TIFF Viewer VS Code",
  "description": "View TIFF and GeoTIFF images in VS Code, including files far larger than memory. Supports custom band composites!",
  "version": "0.7.0",
  "publisher": "shargus",
  "author": {
    "name": "Shargus"
  },
  "contributors": [
    {
      "name": "kiu-chan",
      "url": "https://github.com/kiu-chan"
    }
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shargus/tiff-viewer-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Shargus/tiff-viewer-vscode/issues"
  },
  "homepage": "https://github.com/Shargus/tiff-viewer-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "tiff",
    "tif",
    "bigtiff",
    "geotiff",
    "cog",
    "image",
    "viewer",
    "preview",
    "sentinel",
    "remote sensing",
    "satellite",
    "band composite",
    "ndvi"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "TIFF Viewer VS Code",
      "properties": {
        "tiffViewer.placeSearch.language": {
          "type": "string",
          "default": "",
          "pattern": "^([a-zA-Z]{2,3}(-[a-zA-Z0-9]+)*)?$",
          "patternErrorMessage": "A language code, such as it, en or de",
          "markdownDescription": "Language of the **OSM place search** (a code such as `it`, `en` or `de`): Nominatim names places in it, and it changes which places are found and their order. QGIS's OSM place search plugin uses the language of QGIS. Empty: VS Code's display language."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "tiffViewer.viewer",
        "displayName": "TIFF Viewer",
        "selector": [
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.TIF"
          },
          {
            "filenamePattern": "*.TIFF"
          },
          {
            "filenamePattern": "*.btf"
          },
          {
            "filenamePattern": "*.tf8"
          },
          {
            "filenamePattern": "*.tf2"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "tiffViewer.vector",
        "displayName": "TIFF Viewer (vector layer)",
        "selector": [
          {
            "filenamePattern": "*.geojson"
          },
          {
            "filenamePattern": "*.GEOJSON"
          },
          {
            "filenamePattern": "*.kml"
          },
          {
            "filenamePattern": "*.KML"
          },
          {
            "filenamePattern": "*.kmz"
          },
          {
            "filenamePattern": "*.KMZ"
          },
          {
            "filenamePattern": "*.shp"
          },
          {
            "filenamePattern": "*.SHP"
          },
          {
            "filenamePattern": "*.gpkg"
          },
          {
            "filenamePattern": "*.GPKG"
          },
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.ZIP"
          }
        ],
        "priority": "option"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.tiff-viewer-vscode/presets.jsonc"
        ],
        "url": "./schemas/presets.schema.json"
      }
    ],
    "commands": [
      {
        "command": "tiffViewer.open",
        "title": "Open TIFF Viewer VS Code",
        "category": "TIFF"
      },
      {
        "command": "tiffViewer.openPresets",
        "title": "Open Rendering Presets File",
        "category": "TIFF"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "test": "npm run build && node test/decode.test.mjs && node test/composite.test.mjs && node test/presetStore.test.mjs && node test/overlays.test.mjs && node test/measure.test.mjs",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^7.1.4",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "geographiclib-geodesic": "^2.2.0",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2026.11.15",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.2",
    "maplibre-gl": "^5.24.1",
    "ovsx": "^1.4.0",
    "proj4": "^2.23.0",
    "shpjs": "^6.2.0",
    "sql.js": "^1.17.0",
    "typescript": "^5.9.3"
  }
}
