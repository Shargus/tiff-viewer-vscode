{
  "name": "tiff-viewer-vscode",
  "displayName": "TIFF Viewer VS Code",
  "description": "View TIFF, BigTIFF and GeoTIFF images in VS Code, including files far larger than memory: band composites and band math for multi-band imagery (Sentinel-1, Sentinel-2) with presets, multi-page, tiled, pyramidal (COG), 1–64-bit and float data, and LZW / Deflate / JPEG / ZSTD / WebP / LERC / PackBits / CCITT fax compression.",
  "version": "0.4.0",
  "publisher": "shargus",
  "author": {
    "name": "Shargus"
  },
  "contributors": [
    {
      "name": "kiu-chan",
      "url": "https://github.com/kiu-chan"
    }
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shargus/tiff-viewer-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Shargus/tiff-viewer-vscode/issues"
  },
  "homepage": "https://github.com/Shargus/tiff-viewer-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "tiff",
    "tif",
    "bigtiff",
    "geotiff",
    "cog",
    "image",
    "viewer",
    "preview",
    "sentinel",
    "remote sensing",
    "satellite",
    "band composite",
    "ndvi"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "tiffViewer.viewer",
        "displayName": "TIFF Viewer",
        "selector": [
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.TIF"
          },
          {
            "filenamePattern": "*.TIFF"
          },
          {
            "filenamePattern": "*.btf"
          },
          {
            "filenamePattern": "*.tf8"
          },
          {
            "filenamePattern": "*.tf2"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.tiff-viewer-vscode/presets.jsonc"
        ],
        "url": "./schemas/presets.schema.json"
      }
    ],
    "commands": [
      {
        "command": "tiffViewer.openPresets",
        "title": "Open Rendering Presets File",
        "category": "TIFF"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "test": "npm run build && node test/decode.test.mjs && node test/composite.test.mjs && node test/presetStore.test.mjs && node test/overlays.test.mjs",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^7.1.4",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "geotiff": "^3.0.5",
    "geotiff-geokeys-to-proj4": "^2026.11.15",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.2",
    "maplibre-gl": "^5.24.1",
    "ovsx": "^1.4.0",
    "proj4": "^2.23.0",
    "shpjs": "^6.2.0",
    "sql.js": "^1.17.0",
    "typescript": "^5.9.3"
  }
}
